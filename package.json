{
  "name": "leftover-inspector",
  "version": "0.1.0",
  "description": "Evidence-backed application-leftover discovery and safe cleanup from the terminal.",
  "type": "module",
  "bin": {
    "leftover-inspector": "dist/leftover-inspector"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun build src/main.ts --compile --outfile dist/leftover-inspector"
  },
  "dependencies": {
    "@opentui/core": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
